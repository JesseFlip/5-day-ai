# ── Mode ────────────────────────────────────────────────────────────────
# true = canned tutor replies, in-memory progress, no DB/AI keys needed.
DEMO_MODE=false

# ── Auth (Clerk) — https://dashboard.clerk.com ──────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── Database (Postgres) ────────────────────────────────────────────────
# On Vercel, use a POOLED connection string (e.g. Neon "-pooler" host).
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# ── AI (at least one) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Rate limiting (optional — fails open if unset) ─────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── MCP endpoint auth (/api/mcp) ───────────────────────────────────────
MCP_API_KEY=change-me
