# ── Mode ────────────────────────────────────────────────────────────────
# true = canned tutor replies, in-memory progress, no DB/AI keys needed.
DEMO_MODE=false

# ── Auth (Clerk, optional) — https://dashboard.clerk.com ────────────────
# Leave blank to run without accounts: each browser gets an anonymous ID
# cookie and progress is saved against that.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Database (Postgres) ────────────────────────────────────────────────
# On Vercel, use a POOLED connection string (e.g. Neon "-pooler" host).
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# ── AI (at least one) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional override for the tutor's Gemini model (default: gemini-3.5-flash)
GEMINI_MODEL=

# ── Rate limiting (optional — fails open if unset) ─────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── MCP endpoint auth (/api/mcp) ───────────────────────────────────────
MCP_API_KEY=change-me
